# Copy to `.env` and fill values (never commit `.env`)

BASE_URL=https://jira2-stage.eyepax.info
E2E_LOGIN_PATH=/app_login/
HEADED=false
SLOW_MO=0

# Standard user (required for global-setup session files)
E2E_USER_ID=
E2E_PASSWORD=

# Optional roles — leave empty to skip generating that storage state
E2E_SUPERVISOR_ID=
E2E_SUPERVISOR_PASSWORD=

E2E_ADMIN_ID=
E2E_ADMIN_PASSWORD=

# Forgot-password tests (optional dedicated account)
E2E_FORGOT_PASSWORD_USER_ID=
